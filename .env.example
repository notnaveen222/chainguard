# ChainGuard — example environment configuration.
# Copy to `.env` and fill in as needed. `.env` is gitignored.
#
# EVERY VALUE BELOW IS OPTIONAL. ChainGuard runs fully with no .env file at all.

# --- Application -------------------------------------------------------------
CHAINGUARD_ENVIRONMENT=development
CHAINGUARD_DEBUG=false
CHAINGUARD_LOG_LEVEL=INFO

# --- Detection thresholds ----------------------------------------------------
# Classifier probability at or above which a package is flagged / marked suspect.
CHAINGUARD_MALICIOUS_THRESHOLD=0.60
CHAINGUARD_SUSPICIOUS_THRESHOLD=0.30

# --- Optional AI layer (OpenAI) ---------------------------------------------
# Without a key everything still works: the trained classifier decides and
# explanations are generated locally. With a key, GPT reviews flagged packages,
# writes explanations and powers the dashboard's AI consultant.
# OPENAI_API_KEY=sk-...
CHAINGUARD_LLM_MODEL=gpt-5.6-luna
CHAINGUARD_AI_REVIEW_MAX_PACKAGES=30

# --- Resource limits (security controls — raise with care) -------------------
# CHAINGUARD_LIMIT_MAX_ARCHIVE_BYTES=83886080
# CHAINGUARD_LIMIT_MAX_UNCOMPRESSED_BYTES=419430400
# CHAINGUARD_LIMIT_MAX_DEPENDENCY_DEPTH=6
# CHAINGUARD_LIMIT_MAX_PACKAGES_PER_SCAN=750
