# ---------------------------------------------------------------------------
# ChainGuard — ignore rules
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# ---------------------------------------------------------------------------
# Data directories.
#
# SECURITY: data/quarantine/ holds malicious package samples used to train the
# classifier. They are stored ENCODED at rest (never as runnable source) and are
# never executed by this project — but they must never be committed either.
# See docs/DATASET.md and data/quarantine/README.md.
# ---------------------------------------------------------------------------
# Note the trailing /* rather than /: git cannot re-include a file inside an
# excluded *directory*, so `data/quarantine/` followed by a negation would
# silently drop the safety README that documents what is stored there.
data/quarantine/*
!data/quarantine/README.md

data/cache/
data/corpus/
data/reports/

# Local scan history. Contains absolute paths from this machine and is
# regenerated on first run.
data/*.db
data/*.db-journal
data/models/*.joblib
data/models/*.pkl
!data/models/.gitkeep

# Local config / secrets
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# PPT build tooling
docs/review1/node_modules/
docs/review1/package-lock.json
docs/review1/preview.html

docs/review1/preview2.html
docs/review1/~$*
